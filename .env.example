# Copy this file to .env and fill in your own values. Never commit or share your real .env.
# The backend uses the first .env it finds in hw4/backend/ or any parent folder
# (e.g. a shared course-root .env).

# Required: your Portkey API key (used as both the API key and the x-portkey-api-key header)
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional: model used for every AI call (default: gpt-5.6-sol)
CAMPUS_CUSTOMS_MODEL=gpt-5.6-sol

# Optional: Portkey gateway URL (default: https://api.portkey.ai/v1)
PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Optional: course data folder containing campus_customs.db and products/.
# Default: hw4/data if it exists, otherwise ../data. Relative paths are relative to hw4/.
# CAMPUS_CUSTOMS_DATA_DIR=../data

# Optional: frontend origin allowed by CORS (default: http://localhost:5173)
# CAMPUS_CUSTOMS_FRONTEND_ORIGIN=http://localhost:5173

# Optional: iteration count for the 3 seeded users' legacy pbkdf2_sha256 hashes.
# This is NOT stored in those hashes; get it from the course staff. Until it is
# set, logins for the seeded users report "pending" (new accounts are unaffected).
# CAMPUS_CUSTOMS_LEGACY_PBKDF2_ITERATIONS=
